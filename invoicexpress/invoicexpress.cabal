cabal-version: 3.0

name:           invoicexpress
version:        0.1.0.0
build-type:     Simple

library
  exposed-modules:
      InvoiceXpress
  hs-source-dirs:
      src
  build-depends:
      base >=4.7 && <5
    , invoicexpress:openapi
    , http-client
    , text
    , time
  default-language: Haskell2010
  ghc-options: -Wall

-- Bindings generated by openapi3-code-generator and fixed by hand.
library openapi
  visibility: public
  exposed-modules:
      InvoiceXpress.OpenAPI
      InvoiceXpress.OpenAPI.Operations.GeneratePdf
      InvoiceXpress.OpenAPI.Operations.ListClients
      InvoiceXpress.OpenAPI.Operations.CreateClient
