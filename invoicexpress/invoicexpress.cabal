      InvoiceXpress.OpenAPI.Operations.ListInvoices
      InvoiceXpress.OpenAPI.Operations.CreateGuide
      InvoiceXpress.OpenAPI.Operations.GetGuide
      InvoiceXpress.OpenAPI.Operations.ChangeGuideState
      InvoiceXpress.OpenAPI.Operations.CreateInvoice
      InvoiceXpress.OpenAPI.Operations.GetInvoice
      InvoiceXpress.OpenAPI.Operations.ChangeInvoiceState
      InvoiceXpress.OpenAPI.Operations.SendInvoiceEmail
      InvoiceXpress.OpenAPI.Types
      InvoiceXpress.OpenAPI.TypeAlias
      InvoiceXpress.OpenAPI.Types.Identifier149
      InvoiceXpress.OpenAPI.Types.SendEmail
      InvoiceXpress.OpenAPI.Types.Documents
      InvoiceXpress.OpenAPI.Types.CreateInvoice
      InvoiceXpress.OpenAPI.Types.ChangeState
      InvoiceXpress.OpenAPI.Types.CreateClients
      InvoiceXpress.OpenAPI.Types.ChangeStateGuideRequest
      InvoiceXpress.OpenAPI.Types.ChangeStateInvoiceRequest
      InvoiceXpress.OpenAPI.Types.ClientRequest
      InvoiceXpress.OpenAPI.Types.ClientsGetResponse
      InvoiceXpress.OpenAPI.Types.ClientsListAll
      InvoiceXpress.OpenAPI.Types.CreateBody
      InvoiceXpress.OpenAPI.Types.DocumentClientRequest
      InvoiceXpress.OpenAPI.Types.EmailDocumentRequest
      InvoiceXpress.OpenAPI.Types.FullDocumentObject
      InvoiceXpress.OpenAPI.Types.GlobalDiscountRequest
      InvoiceXpress.OpenAPI.Types.GuideCreateRequest
      InvoiceXpress.OpenAPI.Types.GuideGetResponse
      InvoiceXpress.OpenAPI.Types.InvoiceClient
      InvoiceXpress.OpenAPI.Types.InvoiceCreateRequest
      InvoiceXpress.OpenAPI.Types.InvoiceGetResponse
      InvoiceXpress.OpenAPI.Types.InvoiceItem
      InvoiceXpress.OpenAPI.Types.InvoiceItemRequest
      InvoiceXpress.OpenAPI.Types.InvoiceListAllResponse
      InvoiceXpress.OpenAPI.Types.InvoiceTaxRequest
