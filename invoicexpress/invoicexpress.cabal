      InvoiceXpress.OpenAPI.Configuration
      InvoiceXpress.OpenAPI.SecuritySchemes
      InvoiceXpress.OpenAPI.Common
  hs-source-dirs:
      openapi
  build-depends:
      base >=4.7 && <5
    , text
    , ghc-prim
    , http-conduit
    , http-client
    , http-types
    , bytestring
    , aeson
    , unordered-containers
    , vector
    , scientific
    , time
    , mtl
    , transformers
  default-language: Haskell2010
